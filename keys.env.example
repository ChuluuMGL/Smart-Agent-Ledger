# Smart Agent Ledger key configuration example.
# Copy this file to keys.env, fill in real keys, and keep keys.env private.
# keys.env is ignored by git. Do not put real keys in this example file.

# ---------- DeepSeek ----------
# Optional. If token-to-key routing is not needed, fill only DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=

# Optional named keys for local routing experiments.
DEEPSEEK_KEY_CODING_AGENT_MAIN=
DEEPSEEK_KEY_CODING_AGENT_LAPTOP=

# ---------- GLM ----------
GLM_API_KEY=

# Optional named keys for local routing experiments.
GLM_KEY_CODING_AGENT_MAIN=
GLM_KEY_ALT_AGENT_MAIN=
GLM_KEY_CODING_AGENT_LAPTOP=
GLM_KEY_ALT_AGENT_LAPTOP=

# ---------- Qwen ----------
QWEN_API_KEY=

# ---------- API authentication ----------
# When set, all endpoints except /health require the X-API-Key header unless the
# client IP is in authorized_networks (data/company-agent-nodes.json).
# When blank (and no authorized_networks), the gateway only answers requests
# from this machine (127.0.0.1 / ::1); other clients get 403.
# Required for LAN / Fleet mode. Generate with: openssl rand -hex 32
GATEWAY_API_KEY=

# ---------- Network exposure ----------
# Bind address used by run.sh. Default 127.0.0.1 (this machine only).
# Set to 0.0.0.0 for LAN / Fleet mode, and only together with GATEWAY_API_KEY.
# GATEWAY_HOST=127.0.0.1

# Comma-separated browser origins allowed to call the API cross-origin (CORS).
# Empty = no cross-origin access; the built-in dashboard does not need it.
# SMART_AGENT_LEDGER_CORS_ORIGINS=

# Extra Host header names accepted in no-auth local mode (DNS-rebinding guard).
# SMART_AGENT_LEDGER_ALLOWED_HOSTS=

# Docker only: treat the bridge gateway (traffic from a 127.0.0.1-published port)
# as local. 1 = auto-detect the container's default gateway, or list IPs.
# SMART_AGENT_LEDGER_TRUST_DOCKER_BRIDGE=0
